# Hearth web — environment

# Base URL of the LIVE FastAPI backend the server-side proxy + SSR talk to.
# No trailing slash. Defaults to http://localhost:8000 when unset. The browser
# NEVER calls this directly — only our /api/* route handlers do, attaching the
# httpOnly session token server-side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Where the BROWSER opens the agent (Ember) SSE stream + reads shop data. These
# stay on our SAME-ORIGIN Next route handlers under /api/*. As of Day-22
# (flip-to-live, ADR-0040) those handlers PROXY the live backend at
# NEXT_PUBLIC_API_BASE_URL for the happy path (auth · product · cart · orders ·
# payments · agent SSE). Returns + seller remain mocked until their backend
# lands. Keep these as /api (the proxy boundary) — do not point them at :8000.
# NEXT_PUBLIC_AGENT_STREAM_BASE=/api/agent
# NEXT_PUBLIC_SHOP_API_BASE=/api
