# Hearth web — environment

# Base URL of the FastAPI backend the app talks to (server-side proxy + SSR).
# No trailing slash. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Where the browser opens the agent (Ember) SSE stream + reads shop data. These
# default to our SAME-ORIGIN Next route handlers under /api/* (which serve a MOCK
# stream/fixture while the live backend SSE runtime is on integration/agents).
# At the W3 gate, point these at the live API origin to flip to real streaming —
# the SSE/search/cart clients are unchanged.
# NEXT_PUBLIC_AGENT_STREAM_BASE=/api/agent
# NEXT_PUBLIC_SHOP_API_BASE=/api
