# =============================================================================
# e2e/.env.example — E2E env contract. Copy to e2e/.env and adjust per target.
# NEVER commit a real .env. These let specs target local / dev / CI uniformly.
#
# Resolution order (playwright.config.ts):
#   real process env  >  e2e/.env  >  e2e/.env.example (this file)
# so CI can inject real values, a dev can override locally, and the smoke
# placeholder still resolves the contract with zero setup.
# =============================================================================

# ---- Targets under test -----------------------------------------------------
# Base URL of the Next.js web app the browser navigates to. The @web browser
# smoke self-boots `next start` on this port (3100, not the dev-default 3000, so
# it never collides with a running `next dev`).
WEB_BASE_URL=http://localhost:3100
# Base URL of the FastAPI service (health, agent endpoints, etc.).
API_BASE_URL=http://localhost:8000

# ---- Optional knobs (used by real specs from US-QA-D03 onward) --------------
# Set truthy in CI to enable CI-specific behavior (retries, single worker).
# CI is normally set by the CI provider; listed here for documentation.
# CI=
