{
  "name": "agentic-ecommerce-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end test harness (Playwright) driving web + api + agent flows from one place",
  "scripts": {
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.45.3",
    "dotenv": "16.4.5"
  }
}
