# =============================================================================
# .env.example — copy to .env and adjust. NEVER commit a real .env.
# Every variable referenced by docker-compose.yml is listed here.
# =============================================================================

# ---- Postgres (db service) --------------------------------------------------
POSTGRES_USER=postgres
# Set a real local password here after `cp .env.example .env`. CHANGE_ME is a
# placeholder, not a default — the repo ships no real credentials.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=agentic_ecommerce
# Host port mapped to the container's 5432. Change if 5432 is taken locally.
DB_PORT=5432

# ---- API (api service) ------------------------------------------------------
# DATABASE_URL is derived from the POSTGRES_* values above by docker-compose.yml,
# so you don't set it here for local dev. For an external DB (e.g. Supabase/Neon),
# either override the POSTGRES_* vars above, or set a full URL of the form:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Host port mapped to the api container's 8000.
API_PORT=8000
# pgvector embedding dimension used by Alembic migrations + the embeddings table.
# RATIFIED (ADR-0032): 768 — matches the live provider (Gemini gemini-embedding-001
# MRL-truncated to 768) and the vector(768) column + HNSW vector_cosine_ops index.
# Do NOT change without re-running the embeddings migration.
# See docs/decisions/0018-uuidv7-and-pgvector-dim.md + 0032-embedding-model.md.
EMBED_DIM=768
# Embedding PROVIDER (ADR-0032). Default "stub" = the deterministic, key-free
# StubEmbedder so CI/evals run with NO key (the accepted trade-off). Runtime
# activation of real semantic embeddings: set EMBED_PROVIDER=gemini (one line) with a
# live GEMINI_API_KEY below, then re-seed to re-embed the catalog/policies with Gemini.
EMBED_PROVIDER=stub
# Gemini embedding model (only used when EMBED_PROVIDER=gemini; reuses GEMINI_API_KEY).
# As-built: gemini-embedding-001 serves on the free tier; text-embedding-004 is retired
# (404). Truncated to EMBED_DIM (768) via MRL, then L2-normalized in GeminiEmbedder.
EMBED_MODEL=gemini-embedding-001
# Browser CORS allow-list for the API (comma-separated origins). Not a secret.
# Defaults to the local web dev origin when unset; override for deployed frontends:
#   HEARTH_CORS_ORIGINS=https://your-app.vercel.app,https://admin.your-app.com
HEARTH_CORS_ORIGINS=http://localhost:3000

# ---- Web (web service) ------------------------------------------------------
# Host port mapped to the web container's 3000.
WEB_PORT=3000
# Base URL the browser uses to reach the API (host-side port).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Runtime LLM (product agent layer — US-E5-03/04/09, ADR-0031) -----------
# The product's own agents (shopping/support/merch) run on a chat model. Both
# providers are configured; LLM_PROVIDER flips between them with a single line.
# Groq is the default primary; Gemini is the Day-17 fallback (US-E5-09). Real keys
# go ONLY in the gitignored .env (NEVER commit them — GitGuardian scans history).
LLM_PROVIDER=groq
# Provide the key for whichever provider LLM_PROVIDER selects (CI needs neither —
# tests inject a fake chat model). Leave blank in the committed example.
GROQ_API_KEY=
GEMINI_API_KEY=
# Model names per provider (override only to pin a different free-tier model).
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-flash-latest

# ---- Provider routing + fallback (US-E5-09, ADR-0034 §1) -------------------
# Runtime FAILOVER on top of the LLM_PROVIDER swap. Auto-cascade fires on TRANSIENT
# errors ONLY (HTTP 429 / timeout / 5xx) after a bounded retry of the primary; a
# domain/APIError/guardrail refusal NEVER falls back (it surfaces straight through the
# canonical envelope). Both providers exhausted -> a canonical rate_limited (429), never
# a raw exception or fabricated answer. LLM_FALLBACK_ORDER is a comma-separated provider
# order (the primary normally leads); LLM_PRIMARY_MAX_ATTEMPTS bounds the primary's retry
# before cascading once to the next provider. CI injects fakes — neither key is needed.
LLM_FALLBACK_ORDER=groq,gemini
LLM_PRIMARY_MAX_ATTEMPTS=2

# ---- Semantic cache (US-E5-09, ADR-0034 §2) --------------------------------
# A pgvector-backed, NON-PERSONALIZED response cache so repeated/similar prompts skip the
# LLM round-trip. Cacheable surfaces ONLY: intent classification + grounded policy-RAG
# answers (the never-cache list — shopping/tool-results/PII/refusals/HITL/any injection-
# fired turn — is enforced in code). Ordering is load-bearing: injection scan -> cache
# lookup -> LLM -> cache store. Under EMBED_PROVIDER=stub the cache uses EXACT normalized-
# prompt match (stub similarity is noise); a real embedder uses cosine >= THRESHOLD. A
# lookup failure degrades to a live LLM call, never an internal_error. EMBED_DIM is NOT
# changed by the cache (stays 768 — shared with the embeddings table).
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
# TTL backstops (content-version invalidation is primary): classifier 24h, policy 1h.
SEMANTIC_CACHE_CLASSIFIER_TTL_S=86400
SEMANTIC_CACHE_POLICY_TTL_S=3600

# ---- RAGAS eval judge (US-QA-D16 + US-E7-EJ, ADR-0033 §3) -------------------
# The eval gate's LLM-judge metrics (faithfulness / answer relevancy) run behind a
# Judge seam. EVAL_JUDGE selects which judge ARMS the numeric floors:
#   deterministic -> CI smoke (lexical stub; floors reported, NOT gating). DEFAULT.
#   llm           -> RECOMMENDED armed judge. Scores via the SAME free-tier provider
#                    as the runtime (LLM_PROVIDER -> GROQ_API_KEY / GEMINI_API_KEY
#                    above). One free-tier key arms BOTH the app and the eval gate —
#                    NO paid Anthropic key needed.
#   claude        -> OPTIONAL paid judge (separate Anthropic key below).
# CI leaves this at `deterministic` (no key); the human flips it locally to arm.
EVAL_JUDGE=deterministic
# Optional: score the eval on a DIFFERENT model than the runtime agents use. Blank ->
# reuse the provider's runtime model (GROQ_MODEL / GEMINI_MODEL). Only read for EVAL_JUDGE=llm.
EVAL_LLM_MODEL=
# Only used when EVAL_JUDGE=claude (the optional paid path). Real key goes ONLY in .env.
EVAL_JUDGE_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# ---- Refund / spend guardrail tiers (support agent — US-E5-06/07, ADR-0033) -
# The support agent's refund action is gated by amount tiers, compared in MINOR
# units (integer cents) against the captured payment the refund would touch:
#   <= REFUND_AUTO_CAP_MINOR           -> agent executes (applied)
#   (auto .. REFUND_HITL_CAP_MINOR]    -> queued for a human (hitl_deferred)
#   >  REFUND_HITL_CAP_MINOR           -> hard refused
# Defaults: $50 auto cap, $200 HITL ceiling. Tunable without a code change.
REFUND_AUTO_CAP_MINOR=5000
REFUND_HITL_CAP_MINOR=20000
