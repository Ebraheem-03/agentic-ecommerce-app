# --- Bootstrap .gitignore (Atlas) — Rhea extends this in US-E1-01 for web/ + api/ ---

# Claude Code local-only settings (never commit personal permissions/state)
.claude/settings.local.json

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — only .env.example is ever committed
.env
.env.*
!.env.example

# Logs / temp
*.log

# --- Node / Next.js (web/) ---
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
.npm/
.pnp.*
.yarn/*

# --- Python / FastAPI (api/) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.so
