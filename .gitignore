# --- Bootstrap .gitignore (Atlas) — Rhea extends this in US-E1-01 for web/ + api/ ---

# Claude Code local-only settings + per-agent memory (never commit personal/local state)
.claude/settings.local.json
.claude/agent-memory/
**/.claude/agent-memory/
**/.claude/settings.local.json
# Installed skills + transient agent worktrees are local tooling, not project code
.claude/skills/
.claude/worktrees/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — only .env.example is ever committed
.env
.env.*
!.env.example

# Logs / temp
*.log

# --- Node / Next.js (web/) ---
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
.npm/
.pnp.*
.yarn/*

# --- E2E (Playwright, e2e/) ---
test-results/
playwright-report/
playwright/.cache/
blob-report/

# --- Python / FastAPI (api/) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.so

# Retrieval-smoke run artifacts (generated by US-QA-D10 test; regenerated each run)
docs/qa/eval/results/retrieval-smoke-*.json
